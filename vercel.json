{
  "version": 2,
  "buildCommand": "npm --prefix FrontEnd install && npm --prefix FrontEnd run build",
  "outputDirectory": "FrontEnd/dist",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
